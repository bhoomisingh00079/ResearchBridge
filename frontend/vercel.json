{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/workspace/project-workspace.css",
      "destination": "/workspace/project-workspace.css"
    },
    {
      "source": "/workspace/project-workspace.js",
      "destination": "/workspace/project-workspace.js"
    },
    {
      "source": "/project-workspace.css",
      "destination": "/project-workspace.css"
    },
    {
      "source": "/project-workspace.js",
      "destination": "/project-workspace.js"
    },
    {
      "source": "/workspace",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/workspace/(.*)",
      "destination": "/workspace/$1"
    },
    {
      "source": "/((?!workspace|project-workspace).*)",
      "destination": "/index.html"
    }
  ]
}
