# Copy to .env for local Docker Compose use. Replace secrets before deployment.
APP_ENV=development
POSTGRES_PASSWORD=local-researchbridge-only
SECRET_KEY=
ALLOWED_DOMAINS=ves.ac.in
SITE_ADDRESS=localhost
FRONTEND_ORIGINS=https://localhost,http://localhost:5173
VITE_API_BASE_URL=/api
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=researchbridge@example.edu
PUBLIC_BASE_URL=https://localhost
