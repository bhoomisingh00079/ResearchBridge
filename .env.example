# ==============================================================================
# ResearchBridge Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` in the project root for Docker Compose or local runs.
# Change all secrets, tokens, and passwords before deploying to production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'development', 'staging', or 'production'
APP_ENV=development

# Domain name or IP where the application is hosted
SITE_ADDRESS=localhost
PUBLIC_BASE_URL=https://localhost

# Allowed institutional email domain for student & faculty registrations (SRS 1.3 / FR-001)
# Comma-separated if multiple domains are permitted
ALLOWED_DOMAINS=ves.ac.in

# Cryptographic secret key used for signing session tokens and hashing (at least 32 bytes in prod)
SECRET_KEY=change-to-a-secure-random-32-char-secret-key-12345

# Session Token Lifetime in seconds (default: 43200 = 12 hours)
TOKEN_TTL_SECONDS=43200

# Allowed CORS origins for browser API access (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8000,https://localhost


# ------------------------------------------------------------------------------
# 2. PRIMARY APPLICATION DATABASE (USERS, OPPORTUNITIES, WORKSPACES, AUDIT)
# ------------------------------------------------------------------------------
# ResearchBridge uses SQLAlchemy ORM to manage all core transactional data:
#  - User accounts, roles, profiles, and skills (Member A)
#  - Research opportunities, requirements versions, and applications (Member A)
#  - Projects, project memberships, milestones, tasks, and activity logs (Member B)
#  - Stored agent recommendations and dismissal states (Member C / FR-031)
#  - Administrative audit logs (FR-038)
#
# --- LOCAL DEVELOPMENT (SQLite - default): ---
DATABASE_URL=sqlite:///./researchbridge.db

# --- PRODUCTION / DOCKER COMPOSE (PostgreSQL 16): ---
# DATABASE_URL=postgresql+psycopg://researchbridge:local-researchbridge-only@localhost:5432/researchbridge
# Inside Docker Compose:
# DATABASE_URL=postgresql+psycopg://researchbridge:local-researchbridge-only@db:5432/researchbridge

POSTGRES_DB=researchbridge
POSTGRES_USER=researchbridge
POSTGRES_PASSWORD=local-researchbridge-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Connection pool tuning (optional, defaults provided by backend)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# ------------------------------------------------------------------------------
# 3. ADVISORY & AI AGENT MICROSERVICE (SRS §1.3, §5.2, BR-005, NFR-009)
# ------------------------------------------------------------------------------
# IMPORTANT ARCHITECTURAL NOTE:
# Under SRS Section 5.2 and Business Rule BR-005, the Agent Service is intentionally
# and strictly STATELESS with ZERO DIRECT DATABASE CONNECTION.
#
# - The Agent does NOT connect to PostgreSQL or SQLite.
# - The Agent does NOT have its own separate database or storage engine.
# - Static AST analysis in `test_agent_safety.py` actively asserts that no database
#   drivers (sqlite3, psycopg, sqlalchemy, alembic) are imported by the agent service.
# - All inputs (student skills, project requirements) are passed as structured JSON
#   payloads over internal HTTP POST by the main backend client.
# - Recommendations generated by the agent are persisted solely in the primary
#   database's `agent_recommendations` table by the backend with human-in-the-loop gating.

# URL of the internal Agent Microservice (internal network only, port 8100)
AGENT_SERVICE_URL=http://localhost:8100
# Inside Docker Compose:
# AGENT_SERVICE_URL=http://agent:8100

# Agent service listening port
AGENT_PORT=8100

# Shared HMAC / Bearer service token for Agent microservice authentication (NFR-009)
AGENT_SERVICE_TOKEN=change-me-to-a-strong-random-shared-secret-token

# Advisory client timeout in seconds (NFR-002: advisory failures never block main UI)
AGENT_TIMEOUT_SECONDS=10.0

# Alert threshold: Days of milestone inactivity before triggering a health alert (C3)
INACTIVE_THRESHOLD_DAYS=7

# Alert threshold: Days before application deadline to trigger faculty reminder (C3)
DEADLINE_WARNING_DAYS=7


# ------------------------------------------------------------------------------
# 4. PRIVATE PROJECT FILE STORAGE (Member B / NFR-008)
# ------------------------------------------------------------------------------
# Storage root for private research papers, datasets, and project files.
# Stored outside the public web root using opaque 32-byte tokens.
PRIVATE_FILE_DIR=./private-files

# Maximum file size allowed for upload in bytes (20 MB = 20971520 bytes)
MAX_UPLOAD_BYTES=20971520

# Days ahead to issue upcoming milestone reminders
REMINDER_DAYS=3


# ------------------------------------------------------------------------------
# 5. OUTGOING EMAIL & SMTP SERVICE (Member A / FR-001)
# ------------------------------------------------------------------------------
# Required in production for account verification and password reset emails.
# Leave blank in development to output verification tokens locally in responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=researchbridge@localhost


# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT (Vite / React)
# ------------------------------------------------------------------------------
# Base URL for API requests made by the frontend browser client
VITE_API_BASE_URL=http://localhost:8000
# In production with Caddy reverse proxy:
# VITE_API_BASE_URL=/api
