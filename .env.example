# ==============================================================================
# ResearchBridge Environment Configuration (.env.example)
# Copy this file to `.env` and fill in your values before running/deploying.
# ==============================================================================

# Core Application Environment
APP_ENV=
SITE_ADDRESS=
PUBLIC_BASE_URL=
ALLOWED_DOMAINS=
SECRET_KEY=
TOKEN_TTL_SECONDS=
FRONTEND_ORIGINS=

# Primary Database Configuration
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# Advisory & Agent Microservice (Port 8100, Stateless)
AGENT_SERVICE_URL=
AGENT_PORT=
AGENT_SERVICE_TOKEN=
AGENT_TIMEOUT_SECONDS=
INACTIVE_THRESHOLD_DAYS=
DEADLINE_WARNING_DAYS=

# Private File Storage
PRIVATE_FILE_DIR=
MAX_UPLOAD_BYTES=
REMINDER_DAYS=

# Outgoing Mail / SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend Client
VITE_API_BASE_URL=
