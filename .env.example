# ─── Required ───────────────────────────────────────────────────────
# Shared secret between backend and agent service (SRS 3.3)
AGENT_SERVICE_TOKEN=change-me-to-a-strong-random-string

# ─── Optional ──────────────────────────────────────────────────────
# Agent service URL (backend uses this to call the agent)
AGENT_SERVICE_URL=http://agent:8100

# Milestone inactivity threshold in days (default: 7)
INACTIVE_THRESHOLD_DAYS=7

# Opportunity deadline warning window in days (default: 7)
DEADLINE_WARNING_DAYS=7

